# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local junk / backups
/_scratch_*
/_to_delete/
/_unused_components/
/_bathroom_backup/

# temp scrape / extraction scripts (not part of the app)
/_extract.cjs
/_download.cjs
/_gen_galleries.cjs
/_subpage_*.html
/_subpage-data.json
/_extract-output.txt
